---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: website
  namespace: lab12
spec:
  replicas: 10
  selector:
    matchLabels:
      app: website
  template:
    metadata:
      labels:
        app: website
    spec:
      containers:
        - name: website
          image: registry.hpc.ut.ee/public/sysadm-fizzops-site:latest
          imagePullPolicy: Always
          env:
            - name: VM_NAME
              value: "{{ vm_name }}"
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: website
  namespace: lab12
spec:
  selector:
    app: website
  ports:
    - port: 80
      targetPort: 80
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: website
  namespace: lab12
spec:
  ingressClassName: traefik
  rules:
    - host: "{{ vm_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: website
                port:
                  number: 80
