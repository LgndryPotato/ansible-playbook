<VirtualHost *:80>
    ServerName {{ vm_domain }}

    RewriteEngine On
    RewriteRule "^/etc/passwd" "-" [F]

    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:{{ traefik_http_port }}/
    ProxyPassReverse / http://127.0.0.1:{{ traefik_http_port }}/

    ErrorLog /var/log/httpd/{{ vm_domain }}-error.log
    CustomLog /var/log/httpd/{{ vm_domain }}-access.log combined
</VirtualHost>
