<VirtualHost *:80>
    ServerName {{ blog_domain }}
    DocumentRoot {{ wordpress_root }}

    <Directory "{{ wordpress_root }}">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ForensicLog /var/log/httpd/{{ blog_domain }}-forensic.log
    ErrorLog /var/log/httpd/{{ blog_domain }}-error.log
    CustomLog /var/log/httpd/{{ blog_domain }}-access.log combined
</VirtualHost>
