[Unit]
Description=Week04 Inventory Flask API
After=network.target

[Service]
Type=simple
WorkingDirectory={{ inventory_app_dir }}
Environment=FLASK_RUN_PORT={{ inventory_port }}
ExecStart=/usr/bin/python {{ inventory_app_dir }}/v1/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
